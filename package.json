{
  "name": "osmapp",
  "version": "1.1.0",
  "private": true,
  "description": "A web application for editing OpenStreetMap data with clustering and session management.",
  "keywords": [
    "k-means-clustering",
    "leaflet-map",
    "location",
    "location-services",
    "machine-learning"
  ],
  "homepage": "https://github.com/sarumaj/osmapp#readme",
  "bugs": {
    "url": "https://github.com/sarumaj/osmapp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarumaj/osmapp.git"
  },
  "license": "BSD-3-Clause",
  "author": "Dawid Ciepiela",
  "type": "module",
  "main": "main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "test": "node --test \"tests/js/*.test.mjs\""
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@turf/turf": "7.4.0",
    "clean-css": "^5.3.3",
    "leaflet": "1.9.4",
    "leaflet-control-geocoder": "4.0.0",
    "leaflet-editable": "1.3.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "terser": "^5.49.2"
  },
  "vendorConfig": {
    "destRoot": "src/osmapp/static/vendor",
    "packages": {
      "leaflet": {
        "dest": "unpkg.com/leaflet/dist",
        "files": [
          {
            "src": "dist/leaflet-src.js",
            "out": "leaflet.js"
          },
          {
            "src": "dist/leaflet.css"
          },
          {
            "src": "dist/images"
          }
        ]
      },
      "leaflet-control-geocoder": {
        "dest": "cdn.jsdelivr.net/npm/leaflet-control-geocoder/dist",
        "files": [
          {
            "src": "dist/Control.Geocoder.js",
            "out": "Control.Geocoder.min.js"
          },
          {
            "src": "dist/Control.Geocoder.css"
          },
          {
            "src": "dist/Control.Geocoder.js.map"
          }
        ]
      },
      "leaflet-editable": {
        "dest": "cdn.jsdelivr.net/npm/leaflet-editable/src",
        "files": [
          {
            "src": "src/Leaflet.Editable.js",
            "out": "Leaflet.Editable.min.js"
          }
        ]
      },
      "@turf/turf": {
        "dest": "cdn.jsdelivr.net/npm/turf/turf",
        "files": [
          {
            "src": "turf.min.js"
          }
        ]
      },
      "@fortawesome/fontawesome-free": {
        "dest": "cdnjs.cloudflare.com/ajax/libs/font-awesome",
        "files": [
          {
            "src": "css/all.css",
            "out": "css/all.min.css"
          },
          {
            "src": "webfonts/fa-brands-400.woff2",
            "out": "webfonts/fa-brands-400.woff2"
          },
          {
            "src": "webfonts/fa-solid-900.woff2",
            "out": "webfonts/fa-solid-900.woff2"
          }
        ]
      },
      "pdf-lib": {
        "dest": "unpkg.com/pdf-lib/dist",
        "files": [
          {
            "src": "dist/pdf-lib.min.js"
          }
        ]
      },
      "@pdf-lib/fontkit": {
        "dest": "unpkg.com/@pdf-lib/fontkit/dist",
        "files": [
          {
            "src": "dist/fontkit.umd.min.js"
          }
        ]
      },
      "pdfjs-dist": {
        "dest": "cdn.jsdelivr.net/npm/pdfjs-dist",
        "files": [
          {
            "src": "build/pdf.min.mjs",
            "out": "build/pdf.min.mjs"
          },
          {
            "src": "build/pdf.worker.min.mjs",
            "out": "build/pdf.worker.min.mjs"
          },
          {
            "src": "standard_fonts"
          }
        ]
      }
    }
  }
}
