<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>OSM Territory Mapper</title>
    <meta name="theme-color" content="#3388ff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link
      rel="manifest"
      href="{{ url_for('pwa.manifest', lang=lang) }}"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="{{ url_for('static', filename='icons/icon.svg') }}"
    />
    <link
      rel="apple-touch-icon"
      href="{{ url_for('static', filename='icons/apple-touch-icon.png') }}"
    />
    <link
      rel="stylesheet"
      href="{{ url_for('static', filename='css/style.css') }}"
    />
    {% for code, path in lang_paths.items() -%}
    <link rel="alternate" hreflang="{{ code }}" href="{{ path }}" />
    {% endfor -%}
    <link rel="alternate" hreflang="x-default" href="{{ lang_paths['en'] }}" />
    <script>
      // The server inlines the language dictionary here so the page renders
      // already translated — no extra fetch needed before first paint.
      window.APP_LANG = {{ lang | tojson }};
      window.LANG_PATHS = {{ lang_paths | tojson }};
      window.I18N_BUNDLE = {{ i18n_bundle | tojson }};
      // Available basemap layers, determined server-side via config.AID_LAYERS.
      // All URLs are proxied through the same origin, so changing tile
      // providers requires no client-side changes.
      window.BASEMAPS = {{ basemaps | tojson }};
      // Fallback URL for loading a different language dictionary at runtime
      // (used when switching languages without a page reload).
      window.I18N_URL = "{{ url_for('static', filename='lang/LANG.json') }}";
      // These are ~2 MB of PDF libraries used only for printing territory
      // cards and importing PDF card data. They are loaded lazily by pdfdoc.js
      // on first use; the service worker precaches them so offline printing
      // works.
      window.VENDOR = {
        pdfLib: "{{ url_for('static', filename='vendor/unpkg.com/pdf-lib/dist/pdf-lib.min.js') }}",
        fontkit: "{{ url_for('static', filename='vendor/unpkg.com/@pdf-lib/fontkit/dist/fontkit.umd.min.js') }}",
        pdfjs: "{{ url_for('static', filename='vendor/cdn.jsdelivr.net/npm/pdfjs-dist/build/pdf.min.mjs') }}",
        pdfjsWorker: "{{ url_for('static', filename='vendor/cdn.jsdelivr.net/npm/pdfjs-dist/build/pdf.worker.min.mjs') }}",
        pdfjsStandardFonts: "{{ url_for('static', filename='vendor/cdn.jsdelivr.net/npm/pdfjs-dist/standard_fonts/') }}",
        // DejaVu Sans covers Polish diacritics (ł ą ę ś ż ź ć ń) that PDF's
        // standard 14 fonts cannot render.
        font: "{{ url_for('static', filename='fonts/DejaVuSans.ttf') }}",
      };
    </script>
    <link
      rel="stylesheet"
      href="{{ url_for('static', filename='vendor/unpkg.com/leaflet/dist/leaflet.css') }}"
    />
    <script src="{{ url_for('static', filename='vendor/unpkg.com/leaflet/dist/leaflet.js') }}"></script>
    <script src="{{ url_for('static', filename='vendor/cdn.jsdelivr.net/npm/turf/turf/turf.min.js') }}"></script>
    <link
      rel="stylesheet"
      href="{{ url_for('static', filename='vendor/cdnjs.cloudflare.com/ajax/libs/font-awesome/css/all.min.css') }}"
    />
    <noscript>
      <style>
        /* With scripting off there is no app to wait for, and the splash
           would be the whole page. The map below it does not work either, but
           an empty map says so; a spinner claims something is still coming. */
        #boot-splash {
          display: none;
        }
      </style>
    </noscript>
  </head>

  <body>
    <!-- ═══════════════════════════════════════════════════════════════════
         BOOT SPLASH — the page while there is not an app on it yet.

         What it covers reads as broken rather than as pending: the toolbar is
         built from JS, so it is absent for a moment and then present with
         blank squares where its icons go, because Font Awesome ships
         `font-display: block` and draws nothing until its file lands. main.js
         takes the splash down once those icons will draw.

         Tiles are deliberately not part of that. They arrive over the network
         in their own time and again on every pan, so a map that cannot be
         dragged until they land is worse than one drawn over grey squares.

         The text is rendered server-side from the same dictionary the app
         uses, because it has to be readable before the client-side i18n pass
         runs — which is the whole span this element is on screen for.
         ═══════════════════════════════════════════════════════════════ -->
    <div id="boot-splash">
      <div class="boot-splash__box" role="status" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p class="boot-splash__text">
          {{ i18n_bundle.messages.get("loading", {}).get("starting", "Starting…") }}
        </p>
      </div>
    </div>
    <script>
      // The splash is markup rather than something JS puts up, because the
      // load it covers is the one that might not bring the app in. Which is
      // also why its way down cannot be the app's alone: where main.js never
      // runs — dropped from the load order below, a parse error, a bundle the
      // browser refuses — the spinner is the whole page for as long as the tab
      // is open. main.js catches its own start-up failures and reveals past
      // them; this covers the loads with no main.js left to do it.
      //
      // So the reveal is armed here, ahead of every other script, and main.js
      // only ever gets to make it happen sooner.
      (function () {
        var splash = document.getElementById("boot-splash");
        var done = false;

        window.hideBootSplash = function () {
          if (done || !splash) return;
          done = true;
          splash.classList.add("is-done");
        };

        // Long enough that reaching it means something actually went wrong,
        // short enough that a page which is not coming still hands itself over
        // rather than spinning indefinitely.
        window.setTimeout(window.hideBootSplash, 10000);
      })();
    </script>

    <!-- SVG filters applied to basemap tiles in the print preview (see
         ctx.filter in print.js). They must live inside an <svg> root: a bare
         <filter> in HTML is parsed as an unknown element, and url(#id) will
         not resolve. These filters only affect raster tiles; the border and
         attribution are drawn as vector layers and are already sharp. -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <!-- Unsharp mask. The kernel sums to 1, so overall brightness is
           preserved. -->
      <filter id="tile-sharpen" color-interpolation-filters="sRGB">
        <feConvolveMatrix
          order="3"
          preserveAlpha="true"
          bias="0"
          kernelMatrix="-0.1  -0.1  -0.1
                 -0.1   1.8  -0.1
                 -0.1  -0.1  -0.1"
        />
      </filter>

      <!-- S-curve contrast adjustment on R, G, B channels; alpha is
           untouched. -->
      <filter id="tile-contrast" color-interpolation-filters="sRGB">
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0 0.15 0.45 0.55 0.85 1" />
          <feFuncG type="table" tableValues="0 0.15 0.45 0.55 0.85 1" />
          <feFuncB type="table" tableValues="0 0.15 0.45 0.55 0.85 1" />
        </feComponentTransfer>
      </filter>

      <!-- Grayscale conversion using ITU-R BT.709 luminance coefficients,
           matching CSS grayscale(100%). Alpha is preserved. -->
      <filter id="tile-grayscale" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0
              0.2126 0.7152 0.0722 0 0
              0.2126 0.7152 0.0722 0 0
              0      0      0      1 0"
        />
      </filter>
    </svg>

    <div id="map"></div>

    <!-- ═══════════════════════════════════════════════════════════════════
         LIVE UI — static HTML structure only; all dynamic content is set
         from JS, never built as JS strings.
         ═══════════════════════════════════════════════════════════════ -->

    <div id="loading-overlay" data-mode="simple" hidden>
      <div id="loading-box" role="status" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p class="loading__text" data-role="text">Downloading OSM data…</p>
        <p class="loading__status" data-role="status">Connecting to Overpass</p>
        <div class="loading__phases" data-role="phases"></div>
        <button
          type="button"
          class="btn btn--ghost loading__cancel"
          data-role="cancel"
          data-i18n="loading.cancel"
        >
          Cancel
        </button>
      </div>
    </div>

    <aside id="info-panel">
      <p class="info-panel__title" data-role="title" data-i18n="info.prompt">
        Draw a polygon to load data.
      </p>
      <!-- Labels are static; values are populated by App.ui.setInfo(). -->
      <dl class="info-panel__stats" data-role="stats" hidden>
        <div class="info-panel__stat">
          <dt data-i18n="info.streets">Streets</dt>
          <dd data-role="streets">0</dd>
        </div>
        <div class="info-panel__stat">
          <dt data-i18n="info.buildings">Buildings</dt>
          <dd data-role="buildings">0</dd>
        </div>
        <div class="info-panel__stat" data-role="clusters-row" hidden>
          <dt data-i18n="info.clusters">Territories</dt>
          <dd>
            <!-- This stat is a button (not plain text) because the count
                 alone ("14") doesn't show *which* territories — clicking
                 opens the full list. -->
            <button
              type="button"
              class="info-panel__count"
              data-role="clusters-btn"
              data-i18n-attrs="title=info.clustersHelp"
            >
              <i
                class="fa-solid fa-triangle-exclamation info-panel__warn"
                data-role="clusters-warn"
                aria-hidden="true"
                hidden
              ></i>
              <span data-role="clusters">0</span>
              <i
                class="fa-solid fa-list-ul info-panel__count-icon"
                aria-hidden="true"
              ></i>
            </button>
          </dd>
        </div>
        <div class="info-panel__stat" data-role="printed-row" hidden>
          <dt data-i18n="info.printed">Printed</dt>
          <dd data-role="printed">0</dd>
        </div>
      </dl>
      <p class="info-panel__hint" data-role="hint" hidden></p>
    </aside>

    <!-- ═══════════════════════════════════════════════════════════════════
         TEMPLATES — <template> elements cloned by App.dom.render();
         never assembled via string concatenation.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Toolbar ──────────────────────────────────────────────────────
         A single toolbar panel. controls.js clones tpl-toolbar-group per
         section and tpl-toolbar-button per action, so the grouping is
         defined in a JS array rather than in this markup. -->

    <template id="tpl-toolbar-panel">
      <div class="tb-panel" role="toolbar" aria-label="Tools">
        <button
          type="button"
          class="tb-panel__collapse"
          data-role="collapse"
          data-i18n-attrs="title=toolbar.collapse;aria-label=toolbar.collapse"
        >
          <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <div class="tb-panel__groups" data-role="groups"></div>
      </div>
    </template>

    <template id="tpl-toolbar-group">
      <section class="tb-group">
        <h2 class="tb-group__title" data-role="title"></h2>
        <div class="tb-group__items" data-role="items"></div>
      </section>
    </template>

    <template id="tpl-toolbar-button">
      <a class="tb-item" href="#" role="button">
        <i class="tb-item__icon" data-role="icon" aria-hidden="true"></i>
        <span class="tb-item__label" data-role="label"></span>
      </a>
    </template>

    <!-- The hairline inside the View group, which holds two kinds of control:
         the line that says what is under the map — the zoom pair and the
         pick-one basemap — and the toggle-each overlays below it. That divider
         is most of the explanation the two parts need. -->
    <template id="tpl-toolbar-break">
      <span class="tb-group__break" aria-hidden="true"></span>
    </template>

    <!-- One line under the View group, shown only while an aid basemap is
         selected. The rule it states — cards always print OSM — is otherwise
         invisible until someone has already printed fifty of them. -->
    <template id="tpl-toolbar-note">
      <p class="tb-group__note" role="note" data-i18n="layers.aidNote">
        An on-screen aid only. Territory cards are always printed on the
        OpenStreetMap layer.
      </p>
    </template>

    <!-- The basemap picker. Same shape as the language control below: an
         invisible <select> stretched over the whole tile, with the glyph of the
         current choice and the control's own name drawn underneath it. Three
         mutually exclusive tiles said the same thing in three times the width,
         and the collapsed panel had to find room for all of them.

         The glyph carries no icon class here: controls.js writes the class of
         whichever basemap is current (see BASEMAP_ICONS), and the element is
         empty until it does. -->
    <template id="tpl-basemap-control">
      <div class="tb-item tb-item--select">
        <span class="tb-item__icon" data-role="glyph" aria-hidden="true"></span>
        <span class="tb-item__label" data-i18n="toolbar.labelBasemap">
          Background
        </span>
        <!-- A button rather than a <select>: the list it opens is the app's
             own menu, drawn where the tile is and at the size a finger needs.
             A native pop-up is the browser's to place and to size, and it
             takes both from this control, which is 80 px wide and invisible. -->
        <button
          type="button"
          class="basemap-select"
          data-role="basemap"
          aria-haspopup="menu"
          data-i18n-attrs="aria-label=toolbar.basemap;title=toolbar.basemap"
        ></button>
      </div>
    </template>

    <template id="tpl-language-control">
      <div class="tb-item tb-item--select">
        <span class="tb-item__icon" data-role="flag" aria-hidden="true"></span>
        <span class="tb-item__label" data-i18n="toolbar.labelLanguage">
          Language
        </span>
        <button
          type="button"
          class="lang-select"
          data-role="lang"
          aria-haspopup="menu"
          data-i18n-attrs="aria-label=toolbar.language;title=toolbar.language"
        ></button>
      </div>
    </template>

    <!-- ── Dialog furniture ─────────────────────────────────────────────
         Shared elements injected into every dialog by App.ui.openDialog(),
         so each dialog template doesn't need to duplicate them.

         The veil is a full-screen overlay that blocks interaction with the
         map and toolbar behind the dialog. Without it, aria-modal="true"
         is not effectively enforced — the map can still be panned, buttons
         behind the dialog can still be clicked, and right-clicks can open
         a context menu underneath the dialog.

         The help button provides keyboard-shortcut access on dialogs that
         don't have a hint banner (which is where other modes show the "?"). -->

    <template id="tpl-dialog-veil">
      <div class="dialog-veil"></div>
    </template>

    <template id="tpl-dialog-help">
      <button
        type="button"
        class="app-dialog__help"
        data-i18n-attrs="title=dialog.help;aria-label=dialog.help"
      >
        <i class="fa-solid fa-keyboard" aria-hidden="true"></i>
        <span aria-hidden="true">?</span>
      </button>
    </template>

    <!-- Yes/no confirmation dialog. All fields are populated by
         App.ui.confirm(); this template only defines the layout. -->
    <template id="tpl-confirm-dialog">
      <div
        class="app-dialog confirm-dialog"
        role="alertdialog"
        aria-modal="true"
        tabindex="-1"
      >
        <h2 class="app-dialog__title" data-role="title"></h2>
        <p class="app-dialog__hint confirm-dialog__message" data-role="message"></p>
        <p class="confirm-dialog__detail" data-role="detail" hidden></p>
        <div class="app-dialog__actions">
          <button type="button" class="btn btn--ghost" data-role="cancel">
            Cancel
          </button>
          <!-- Optional third button, shown when the caller passes altKey.
               Used for "replace this boundary?" where the third option is
               "edit the existing one instead". -->
          <button type="button" class="btn btn--ghost" data-role="alt" hidden>
            Edit instead
          </button>
          <button type="button" class="btn btn--primary" data-role="ok">
            OK
          </button>
        </div>
      </div>
    </template>

    <!-- ── Territory list ───────────────────────────────────────────────
         Dialog opened from the territory count in the info panel. One row
         per territory; clicking a row zooms to it on the map. -->

    <template id="tpl-territory-list">
      <div
        class="app-dialog territory-list"
        role="dialog"
        aria-modal="true"
        aria-labelledby="territory-list-title"
        tabindex="-1"
      >
        <h2
          class="app-dialog__title"
          id="territory-list-title"
          data-i18n="list.title"
        >
          Territories
        </h2>
        <p class="app-dialog__hint" data-role="total"></p>
        <p class="territory-list__notes" data-role="notes" hidden></p>
        <label class="territory-list__toggle">
          <input type="checkbox" data-role="show-numbers" />
          <span data-i18n="list.showNumbers">Show the numbers on the map</span>
        </label>
        <!-- Finding one row among ninety-nine. Each chip is one question
             with three answers — don't care, only these, only the others —
             so they combine: "printed, and still has something wrong with
             it" is two clicks and needs no entry of its own. A drop-down
             could only ever offer one axis at a time, and next to the jump
             button it read as an unrelated control rather than as the other
             half of the same tool. The labels carry the state in words
             because a chip that says "No issues" needs no legend. -->
        <div
          class="territory-list__find"
          role="group"
          data-i18n-attrs="aria-label=list.filterGroup"
        >
          <button
            type="button"
            class="territory-list__chip"
            data-role="chip"
            data-axis="repair"
            aria-pressed="false"
          >
            <i class="fa-solid fa-puzzle-piece" aria-hidden="true"></i>
            <span data-role="chip-label"></span>
          </button>
          <button
            type="button"
            class="territory-list__chip"
            data-role="chip"
            data-axis="printed"
            aria-pressed="false"
          >
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span data-role="chip-label"></span>
          </button>
          <button
            type="button"
            class="territory-list__chip territory-list__jump"
            data-role="jump"
            data-i18n-attrs="title=list.jumpHint;aria-label=list.jumpHint"
            hidden
          >
            <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
            <span data-role="jump-count"></span>
          </button>
        </div>
        <!-- Always present and never hidden: a live region that is added to
             the page at the moment it gains text is not reliably announced,
             so it is empty rather than absent when there is nothing to say. -->
        <p class="territory-list__status" data-role="outcome" role="status"></p>
        <div class="territory-list__rows" data-role="rows" role="list"></div>
        <p
          class="app-dialog__hint territory-list__nothing"
          data-role="empty"
          data-i18n="list.empty"
          hidden
        >
          No territories yet.
        </p>
        <p
          class="app-dialog__hint territory-list__nothing"
          data-role="no-match"
          data-i18n="list.noMatch"
          hidden
        >
          Nothing matches that filter.
        </p>
        <div class="app-dialog__actions">
          <!-- What is selected, and the way out of it. The selection outlives
               the dialog — closing hands it to the map, where merge and
               delete act on it — so saying how big it is before you close is
               the difference between a deliberate hand-over and a surprise. -->
          <span
            class="territory-list__selection"
            data-role="selection"
            aria-live="polite"
            hidden
          ></span>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="clear-selection"
            data-i18n="list.clearSelection"
            hidden
          >
            Clear
          </button>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="fix-all"
            data-i18n="list.fixAll"
            data-i18n-attrs="title=list.fixAllHint"
            hidden
          >
            Fix all
          </button>
          <button
            type="button"
            class="btn btn--primary"
            data-role="close"
            data-i18n="list.close"
          >
            Close
          </button>
        </div>
      </div>
    </template>

    <!-- Every row in the list uses this, whether it stands for a territory
         or for a piece of ground in no territory at all. The main button goes
         to it on the map; the rest depend on which of the two it is. A
         territory offers print, and the wand when App.autoheal can repair the
         fault its flags name — a shape drawn in pieces, one with no buildings
         that a neighbor can take, or a boundary drawn through a building that
         can be moved onto its wall. Uncovered ground has no card to
         print and always offers both of its own: the wand adopts it and then
         repairs what that made, and the droplet closes it. -->
    <template id="tpl-territory-row">
      <div class="territory-row-wrap" role="listitem">
        <button type="button" class="territory-row" data-role="go">
          <span class="territory-row__num" data-role="num"></span>
          <span class="territory-row__body">
            <span class="territory-row__main" data-role="main"></span>
            <span class="territory-row__meta" data-role="meta"></span>
          </span>
          <!-- Inside the button, so that hovering a flag hovers the row and
               clicking one clicks through to it. They were briefly outside it
               to make room for a flag that was itself a button; that flag is
               gone, and with it the reason. -->
          <span class="territory-row__flags" data-role="flags"></span>
          <!-- The selected state is a color and a border, which is nothing at
               all to a screen reader. This says it in words and is hidden
               from everybody who can already see it. -->
          <span class="sr-only" data-role="selected-note"></span>
        </button>
        <button
          type="button"
          class="territory-row__action territory-row__fix"
          data-role="fix"
          data-i18n-attrs="title=list.fix;aria-label=list.fix"
          hidden
        >
          <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
        </button>
        <!-- Uncovered ground only: a territory has nothing to close, and a
             piece of ground nobody covers has no card to print — so exactly
             one of these two is ever shown on a row. -->
        <button
          type="button"
          class="territory-row__action territory-row__dissolve"
          data-role="dissolve"
          data-i18n-attrs="title=list.dissolve;aria-label=list.dissolve"
          hidden
        >
          <i class="fa-solid fa-droplet" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          class="territory-row__action"
          data-role="print"
          data-i18n-attrs="title=list.print;aria-label=list.print"
        >
          <i class="fa-solid fa-print" aria-hidden="true"></i>
        </button>
      </div>
    </template>

    <template id="tpl-phase-item">
      <div class="phase-item">
        <span class="phase-icon" aria-hidden="true"></span>
        <span class="phase-label"></span>
      </div>
    </template>

    <template id="tpl-cluster-dialog">
      <div
        class="app-dialog cluster-dialog"
        role="dialog"
        aria-modal="true"
        aria-label="Auto-partition settings"
      >
        <h2 class="app-dialog__title" data-i18n="partition.title">
          Split into territories
        </h2>
        <p class="app-dialog__hint" data-i18n="partition.hint">
          Choose how the area is divided.
        </p>

        <div class="app-dialog__group" role="radiogroup">
          <label class="app-dialog__option" data-role="label-buildings">
            <input type="radio" name="cluster-mode" value="buildings" />
            <span>
              <strong data-i18n="partition.byBuildings"
                >By building count</strong
              >
              <em data-i18n="partition.byBuildingsHint">
                Each territory gets roughly N buildings.
              </em>
            </span>
          </label>
          <label class="app-dialog__option">
            <input type="radio" name="cluster-mode" value="area" />
            <span>
              <strong data-i18n="partition.byCount">By territory count</strong>
              <em data-i18n="partition.byCountHint">
                Territories of roughly equal area.
              </em>
            </span>
          </label>
        </div>

        <p class="app-dialog__row" data-role="row-buildings" hidden>
          <label>
            <span data-i18n="partition.buildingsPer"
              >Buildings per territory</span
            >
            <input type="number" data-role="input-buildings" min="1" step="1" />
          </label>
        </p>
        <p class="app-dialog__row" data-role="row-area" hidden>
          <label>
            <span data-i18n="partition.count">Number of territories</span>
            <input
              type="number"
              data-role="input-k"
              min="2"
              max="50"
              step="1"
              value="5"
            />
          </label>
        </p>

        <p class="app-dialog__calc" data-role="calc" aria-live="polite"></p>

        <div class="app-dialog__actions">
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="partition.cancel"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn btn--primary"
            data-role="submit"
            data-i18n="partition.submit"
          >
            Split
          </button>
        </div>
      </div>
    </template>

    <template id="tpl-boundary-dialog">
      <div
        class="app-dialog boundary-dialog"
        role="dialog"
        aria-modal="true"
        aria-label="Use the administrative boundary"
      >
        <h2 class="app-dialog__title" data-i18n="boundary.title">
          Use this boundary?
        </h2>
        <p class="app-dialog__hint" data-role="hint" data-i18n="boundary.hint">
          OpenStreetMap has an outline for this place. Use it instead of drawing
          the outer boundary by hand.
        </p>

        <p class="boundary-dialog__name" data-role="name"></p>
        <p class="boundary-dialog__meta" data-role="meta"></p>
        <p class="boundary-dialog__note" data-role="parts" hidden></p>

        <p class="app-dialog__row" data-role="row-detail">
          <label>
            <span data-i18n="boundary.detail">Detail</span>
            <input
              type="range"
              data-role="detail"
              min="0"
              max="5"
              step="1"
              value="0"
            />
            <output data-role="detail-out"></output>
          </label>
        </p>

        <p class="app-dialog__calc is-error" data-role="warn" hidden></p>

        <div class="app-dialog__actions">
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="boundary.cancel"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="box"
            data-i18n="boundary.useBox"
          >
            Use bounding box
          </button>
          <button
            type="button"
            class="btn btn--primary"
            data-role="use"
            data-i18n="boundary.useBoundary"
          >
            Use boundary
          </button>
        </div>
      </div>
    </template>

    <template id="tpl-merge-toolbar">
      <div class="merge-toolbar" role="toolbar" aria-label="Merge clusters">
        <span class="merge-toolbar__count" data-role="count" aria-live="polite">
          0 selected
        </span>
        <div class="merge-toolbar__actions">
          <button
            type="button"
            class="btn btn--primary"
            data-role="merge"
            data-i18n="merge.action"
          >
            Merge
          </button>
          <!-- Trim has had one of these since it shipped. Merge collects a
               selection exactly the same way and had no way to drop it
               short of leaving the mode and losing it. -->
          <button
            type="button"
            class="btn btn--ghost"
            data-role="clear"
            data-i18n="merge.clear"
          >
            Clear
          </button>
          <!-- Merge is not the only thing a selection is for, and it was the
               only thing this bar offered: deleting fourteen territories
               meant fourteen trips through a context menu. -->
          <button
            type="button"
            class="btn btn--danger"
            data-role="delete"
            data-i18n="merge.deleteSelected"
          >
            Delete
          </button>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="merge.cancel"
          >
            Cancel
          </button>
        </div>
      </div>
    </template>

    <!-- ── Outline editor ───────────────────────────────────────────────
         Same layout shell as the cut and trim toolbars. Vertex dragging
         handles are provided by Leaflet.Editable, so this toolbar only
         carries what the library doesn't: a corner count, the shape's
         displacement, and apply/cancel controls. -->

    <template id="tpl-outline-toolbar">
      <div class="outline-toolbar" role="toolbar" aria-label="Edit boundary">
        <div class="outline-toolbar__head">
          <span class="outline-toolbar__count" data-role="count">0 corners</span>
          <span
            class="outline-toolbar__status"
            data-role="status"
            aria-live="polite"
          ></span>
        </div>
        <div class="outline-toolbar__actions">
          <button
            type="button"
            class="btn btn--primary"
            data-role="apply"
            data-i18n="outline.apply"
          >
            Apply
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--icon"
            data-role="undo"
            data-i18n-attrs="title=outline.undo;aria-label=outline.undo"
          >
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--icon"
            data-role="redo"
            data-i18n-attrs="title=outline.redo;aria-label=outline.redo"
          >
            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
          </button>
          <button type="button" class="btn btn--ghost" data-role="reset">
            <span data-i18n="outline.reset">Reset</span>
            <kbd>R</kbd>
          </button>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="outline.cancel"
          >
            Cancel
          </button>
        </div>
      </div>
    </template>

    <template id="tpl-outline-hint">
      <div class="draw-hint" role="status" data-i18n="outline.hint">
        Drag a corner to move it · Click a corner to delete it · Hold X and
        sweep to rub out a run of them · Drag the small dot between two
        corners to add one · Enter applies · ? for all keys
      </div>
    </template>

    <template id="tpl-merge-hint">
      <div class="draw-hint" role="status" data-i18n="merge.hint">
        Click territories to select them · Right-click for the menu · Enter
        merges · Backspace drops the last one · ? for all keys
      </div>
    </template>

    <!-- Visual indicator showing the eraser brush size at the pointer
         position, so the user can see how wide the erase stroke will be
         before dragging. -->
    <template id="tpl-vertex-eraser">
      <div class="vertex-eraser" aria-hidden="true"></div>
    </template>

    <template id="tpl-draw-hint">
      <div class="draw-hint" role="status" data-i18n="draw.hint">
        Click to place vertices · Hold Alt to ignore snapping · Right-drag to
        pan · Right-click for the menu · Enter or double-click to cut ·
        Backspace steps back · ? for all keys
      </div>
    </template>

    <template id="tpl-cut-toolbar">
      <div class="cut-toolbar" role="toolbar" aria-label="Cut tool">
        <div class="cut-toolbar__head">
          <span class="cut-toolbar__count" data-role="count">0 vertices</span>
          <span
            class="cut-toolbar__status"
            data-role="status"
            aria-live="polite"
          ></span>
        </div>
        <div class="cut-toolbar__opts">
          <label class="cut-toolbar__opt">
            <input type="checkbox" data-role="snap" />
            <span data-i18n="cut.snap">Snap to streets</span>
            <kbd>S</kbd>
          </label>
          <label class="cut-toolbar__opt">
            <input type="checkbox" data-role="edges" />
            <span data-i18n="cut.edges">Snap to territory edges</span>
            <kbd>B</kbd>
          </label>
          <label class="cut-toolbar__opt">
            <input type="checkbox" data-role="follow" />
            <span data-i18n="cut.follow">Follow streets between vertices</span>
            <kbd>F</kbd>
          </label>
        </div>
        <div class="cut-toolbar__actions">
          <button
            type="button"
            class="btn btn--primary"
            data-role="finish"
            data-i18n="cut.finish"
          >
            Cut
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--icon"
            data-role="undo"
            data-i18n-attrs="title=cut.undo;aria-label=cut.undo"
          >
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--icon"
            data-role="redo"
            data-i18n-attrs="title=cut.redo;aria-label=cut.redo"
          >
            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="cut.cancel"
          >
            Cancel
          </button>
        </div>
      </div>
    </template>

    <!-- Same layout shell as the cut and merge toolbars for visual
         consistency across editing modes. -->
    <template id="tpl-trim-toolbar">
      <div class="trim-toolbar" role="toolbar" aria-label="Trim boundary">
        <div class="trim-toolbar__head">
          <span class="trim-toolbar__count" data-role="count">0 ignored</span>
          <span
            class="trim-toolbar__status"
            data-role="status"
            aria-live="polite"
          ></span>
        </div>
        <div class="trim-toolbar__row">
          <label data-role="reach-label" data-i18n="trim.reach">
            Reach behind buildings
          </label>
          <input
            type="range"
            data-role="reach"
            min="20"
            max="150"
            step="5"
            data-i18n-attrs="aria-label=trim.reach"
          />
          <output data-role="reach-out"></output>
        </div>
        <div class="trim-toolbar__row">
          <label data-role="detail-label" data-i18n="trim.detail">
            Edge detail
          </label>
          <input
            type="range"
            data-role="detail"
            min="0"
            max="45"
            step="5"
            data-i18n-attrs="aria-label=trim.detail"
          />
          <output data-role="detail-out"></output>
        </div>
        <!-- Controls the rule that proposes exclusions, not the output
             directly. Values are multiples of the area's own plot spacing,
             so the same slider setting has consistent meaning across
             dense terraces and open farmland. -->
        <div class="trim-toolbar__row">
          <label data-role="isolation-label" data-i18n="trim.isolation">
            How far out is isolated
          </label>
          <input
            type="range"
            data-role="isolation"
            min="10"
            max="200"
            step="1"
            data-i18n-attrs="aria-label=trim.isolation"
          />
          <output data-role="isolation-out"></output>
        </div>
        <div class="trim-toolbar__row">
          <label data-role="group-label" data-i18n="trim.group">
            Largest place dropped
          </label>
          <input
            type="range"
            data-role="group"
            min="1"
            max="60"
            step="1"
            data-i18n-attrs="aria-label=trim.group"
          />
          <output data-role="group-out"></output>
        </div>
        <div class="trim-toolbar__opts">
          <label class="trim-toolbar__opt">
            <input type="checkbox" data-role="follow" />
            <span data-i18n="trim.follow">Follow streets</span>
            <kbd>F</kbd>
          </label>
          <!-- When this is checked, the sliders and selection are locked
               to prevent manual adjustments from being discarded by a
               recompute. -->
          <label class="trim-toolbar__opt">
            <input type="checkbox" data-role="edit" />
            <span data-i18n="trim.adjust">Adjust corners by hand</span>
            <kbd>E</kbd>
          </label>
        </div>
        <div class="trim-toolbar__actions">
          <button
            type="button"
            class="btn btn--primary"
            data-role="apply"
            data-i18n="trim.apply"
          >
            Apply
          </button>
          <button type="button" class="btn btn--ghost" data-role="outliers">
            <span data-i18n="trim.outliers">Outliers</span>
            <kbd>O</kbd>
          </button>
          <button type="button" class="btn btn--ghost" data-role="clear">
            <span data-i18n="trim.clear">Clear</span>
            <kbd>C</kbd>
          </button>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="trim.cancel"
          >
            Cancel
          </button>
        </div>
      </div>
    </template>

    <!-- ── Context menu ─────────────────────────────────────────────────
         A single shell populated by App.ui.showContextMenu() from a list
         of items. Every editing mode that has a toolbar also gets a
         right-click context menu using this same template. -->

    <!-- ═══════════════════════════════════════════════════════════════════
         NOTES — the annotation tool's furniture.

         One bar for the four tools, one banner whose wording notes.js
         re-targets as the tool changes, and the dialog that asks for the text
         of a note or a pin.
         ═══════════════════════════════════════════════════════════ -->
    <template id="tpl-notes-toolbar">
      <div class="notes-toolbar" role="toolbar" aria-label="Notes">
        <div class="notes-toolbar__head">
          <span class="notes-toolbar__count" data-role="count">0 notes</span>
          <span
            class="notes-toolbar__status"
            data-role="status"
            aria-live="polite"
          ></span>
        </div>

        <div class="notes-toolbar__tools" role="group">
          <button type="button" class="notes-tool" data-role="tool-note">
            <i class="fa-solid fa-note-sticky" aria-hidden="true"></i>
            <span data-i18n="notes.toolNote">Note</span>
            <kbd>1</kbd>
          </button>
          <button type="button" class="notes-tool" data-role="tool-pin">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <span data-i18n="notes.toolPin">Pin</span>
            <kbd>2</kbd>
          </button>
          <button type="button" class="notes-tool" data-role="tool-draw">
            <i class="fa-solid fa-pencil" aria-hidden="true"></i>
            <span data-i18n="notes.toolDraw">Draw</span>
            <kbd>3</kbd>
          </button>
          <button type="button" class="notes-tool" data-role="tool-text">
            <i class="fa-solid fa-font" aria-hidden="true"></i>
            <span data-i18n="notes.toolText">Text</span>
            <kbd>4</kbd>
          </button>
        </div>

        <div class="notes-toolbar__pen">
          <label class="notes-toolbar__opt" data-role="freeform-row">
            <input type="checkbox" data-role="freeform" />
            <span data-i18n="notes.freeform">Freeform</span>
            <kbd>F</kbd>
          </label>
          <label class="notes-toolbar__opt" data-role="snap-row">
            <input type="checkbox" data-role="snap" />
            <span data-i18n="notes.snap">Snap to streets</span>
            <kbd>S</kbd>
          </label>
          <label class="notes-toolbar__field">
            <span data-i18n="notes.color">Color</span>
            <input type="color" data-role="color" value="#d40000" />
          </label>
          <label class="notes-toolbar__field">
            <span data-i18n="notes.width">Thickness</span>
            <input
              type="range"
              data-role="width"
              min="0.5"
              max="8"
              step="0.5"
              value="2"
            />
            <output data-role="width-out"></output>
          </label>
        </div>

        <div class="notes-toolbar__actions">
          <button
            type="button"
            class="btn btn--primary"
            data-role="finish"
            data-i18n="notes.finish"
            hidden
          >
            Finish line
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--icon"
            data-role="undo"
            data-i18n-attrs="title=notes.undo;aria-label=notes.undo"
          >
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--icon"
            data-role="redo"
            data-i18n-attrs="title=notes.redo;aria-label=notes.redo"
          >
            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="done"
            data-i18n="notes.done"
          >
            Done
          </button>
        </div>
      </div>
    </template>

    <template id="tpl-notes-hint">
      <div class="draw-hint" role="status" data-i18n="notes.hintNote">
        Click where the note belongs · Right-click for the tools · Esc leaves ·
        ? for all keys
      </div>
    </template>

    <template id="tpl-note-dialog">
      <div
        class="app-dialog note-dialog"
        role="dialog"
        aria-modal="true"
        data-i18n-attrs="aria-label=notes.titleNote"
        aria-label="Note"
      >
        <h2 class="app-dialog__title" data-role="title">Note</h2>
        <textarea
          class="note-dialog__text"
          data-role="text"
          rows="4"
          data-i18n-attrs="placeholder=notes.placeholder"
        ></textarea>
        <p class="app-dialog__hint" data-i18n="notes.textHint">
          Ctrl+Enter saves. On a printed PDF this becomes a comment any reader
          can open; on a PNG it is drawn onto the map.
        </p>
        <div class="app-dialog__actions">
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="notes.cancel"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn btn--primary"
            data-role="save"
            data-i18n="notes.save"
          >
            Save
          </button>
        </div>
      </div>
    </template>

    <template id="tpl-context-menu">
      <div class="polygon-context-menu" role="menu"></div>
    </template>

    <template id="tpl-context-menu-item">
      <button type="button" class="polygon-context-menu-item" role="menuitem">
        <i class="fa-solid" data-role="icon" aria-hidden="true"></i>
        <span data-role="label"></span>
      </button>
    </template>

    <template id="tpl-context-menu-divider">
      <div class="polygon-context-menu-divider" role="separator"></div>
    </template>

    <!-- ── Keyboard sheet ───────────────────────────────────────────────
         The shortcuts dialog is rendered from App.shortcuts' registry —
         the same data structure that dispatches key presses also
         populates this list, so the documentation can never go stale. -->

    <template id="tpl-shortcuts-dialog">
      <div
        class="app-dialog shortcuts-dialog"
        role="dialog"
        aria-modal="true"
        tabindex="-1"
      >
        <h2 class="app-dialog__title" data-i18n="shortcuts.title">
          Keyboard and mouse
        </h2>
        <p class="app-dialog__hint" data-i18n="shortcuts.hint">
          What a key does depends on the tool you are in. The tool you are in
          now is listed first.
        </p>
        <div class="shortcuts-dialog__groups" data-role="groups"></div>
        <div class="app-dialog__actions">
          <button
            type="button"
            class="btn btn--primary"
            data-role="close"
            data-i18n="shortcuts.close"
          >
            Close
          </button>
        </div>
      </div>
    </template>

    <template id="tpl-shortcuts-group">
      <section class="shortcuts-group">
        <h3 class="shortcuts-group__title" data-role="title"></h3>
        <ul class="shortcuts-group__list" data-role="items"></ul>
      </section>
    </template>

    <template id="tpl-shortcuts-item">
      <li class="shortcuts-item">
        <span class="shortcuts-item__keys" data-role="keys"></span>
        <span class="shortcuts-item__label" data-role="label"></span>
      </li>
    </template>

    <template id="tpl-print-dialog">
      <div
        class="app-dialog print-dialog"
        role="dialog"
        aria-modal="true"
        data-i18n-attrs="aria-label=print.title"
        aria-label="Print territory card"
      >
        <h2 class="app-dialog__title" data-role="title" data-i18n="print.title">
          Print territory card
        </h2>

        <div class="print-dialog__body">
          <div class="print-preview">
            <canvas data-role="canvas"></canvas>
            <div class="erase-cursor" data-role="erase-cursor" hidden></div>
            <p class="print-preview__status" data-role="status">
              <span
                class="spinner spinner--sm"
                data-role="status-spinner"
                aria-hidden="true"
              ></span>
              <span data-role="status-text">Loading map tiles…</span>
            </p>
          </div>

          <div class="print-controls">
            <fieldset class="print-controls__group">
              <legend data-i18n="print.frame">Frame</legend>

              <label class="print-controls__field">
                <span data-i18n="print.zoom">Zoom</span>
                <input type="range" data-role="zoom" />
                <button
                  type="button"
                  class="btn btn--ghost print-fit"
                  data-role="fit"
                  data-i18n="print.fit"
                >
                  Fit
                </button>
              </label>

              <label class="print-controls__field">
                <span data-i18n="print.rotation">Rotation</span>
                <input
                  type="range"
                  data-role="rotation"
                  min="-180"
                  max="180"
                  step="1"
                  value="0"
                />
                <output data-role="rotation-out"></output>
              </label>
              <div class="print-controls__row">
                <button
                  type="button"
                  class="btn btn--ghost"
                  data-role="rotate-ccw"
                  data-i18n-attrs="title=print.rotateCcw;aria-label=print.rotateCcw"
                >
                  <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                </button>
                <button
                  type="button"
                  class="btn btn--ghost"
                  data-role="rotate-reset"
                  data-i18n-attrs="title=print.rotateReset;aria-label=print.rotateReset"
                >
                  0°
                </button>
                <button
                  type="button"
                  class="btn btn--ghost"
                  data-role="rotate-cw"
                  data-i18n-attrs="title=print.rotateCw;aria-label=print.rotateCw"
                >
                  <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                </button>
              </div>

              <p class="print-controls__hint" data-i18n="print.frameHint">
                Drag to move, scroll to zoom, Shift-drag to rotate.
              </p>
            </fieldset>

            <fieldset class="print-controls__group">
              <legend data-i18n="print.basemap">Basemap</legend>
              <label class="print-controls__field">
                <span data-i18n="print.detail">Label size</span>
                <input
                  type="range"
                  data-role="detail"
                  min="0"
                  max="2"
                  step="1"
                  value="1"
                  list="detail-marks"
                />
                <datalist id="detail-marks">
                  <option value="0"></option>
                  <option value="1"></option>
                  <option value="2"></option>
                </datalist>
                <output data-role="detail-out"></output>
              </label>
              <label class="print-controls__check">
                <input type="checkbox" data-role="sharpen" checked />
                <span data-i18n="print.sharpen">Sharpen the map</span>
              </label>
              <label class="print-controls__check">
                <input type="checkbox" data-role="contrast" />
                <span data-i18n="print.contrast">Increase contrast</span>
              </label>
              <label class="print-controls__check">
                <input type="checkbox" data-role="grayscale" />
                <span data-i18n="print.grayscale">Grayscale the map</span>
              </label>
              <p
                class="print-controls__note"
                data-role="filter-note"
                role="status"
                hidden
              ></p>
              <!-- Shown by print.js only while an aid basemap is selected. -->
              <p
                class="print-controls__note"
                data-role="osm-only"
                data-i18n="print.osmOnly"
                role="status"
                hidden
              >
                Cards are always drawn on the OpenStreetMap basemap, whichever
                layer is shown on the map.
              </p>
              <p class="print-controls__hint" data-i18n="print.detailHint">
                Three steps, each doubling the size of street names at the cost
                of sharpness. Tiles only exist at whole zoom levels, so there is
                nothing in between.
              </p>
            </fieldset>

            <fieldset class="print-controls__group">
              <legend data-i18n="print.decorations">Scale and compass</legend>
              <label class="print-controls__check">
                <input type="checkbox" data-role="scale" />
                <span data-i18n="print.scale">Draw a scale bar</span>
              </label>
              <label class="print-controls__check">
                <input type="checkbox" data-role="compass" />
                <span data-i18n="print.compass">Draw a compass rose</span>
              </label>
              <p class="print-controls__hint" data-i18n="print.decorationsHint">
                Drawn on top of the finished card. The compass turns with the
                map so that north keeps pointing north; its letters and the
                scale bar stay upright.
              </p>
            </fieldset>

            <!-- Hidden by print.js when the map carries no annotations: two
                 switches over what to do with the notes are two questions
                 about something that does not exist, in a column that is
                 already five fieldsets long. -->
            <fieldset class="print-controls__group" data-role="notes-group">
              <legend data-i18n="print.notesGroup">Notes</legend>
              <label class="print-controls__check">
                <input type="checkbox" data-role="notes" checked />
                <span data-i18n="print.notes">Include the notes</span>
              </label>
              <p class="print-controls__hint" data-i18n="print.notesHint">
                A PDF card carries them as real annotations - one ink drawing
                per note, pin and mark - which any reader can open, move or
                delete. A PNG has nowhere to put those, so they are drawn onto
                the map instead.
              </p>
              <label class="print-controls__check">
                <input type="checkbox" data-role="note-text" checked />
                <span data-i18n="print.noteText">Draw the words on the card</span>
              </label>
              <p class="print-controls__hint" data-i18n="print.noteTextHint">
                Off, a note keeps its mark and its words go only into the PDF's
                comments, which leaves a crowded card readable. A caption is
                nothing but words, so it is drawn either way.
              </p>
            </fieldset>

            <fieldset class="print-controls__group">
              <legend data-i18n="print.border">Border</legend>
              <label class="print-controls__field">
                <span data-i18n="print.color">Color</span>
                <input type="color" data-role="color" value="#d40000" />
              </label>
              <label class="print-controls__field">
                <span data-i18n="print.thickness">Thickness</span>
                <input
                  type="range"
                  data-role="width"
                  min="0.5"
                  max="8"
                  step="0.5"
                  value="2"
                />
                <output data-role="width-out"></output>
              </label>
              <label class="print-controls__field">
                <span data-i18n="print.opacity">Opacity</span>
                <input
                  type="range"
                  data-role="opacity"
                  min="10"
                  max="100"
                  step="5"
                  value="100"
                />
                <output data-role="opacity-out"></output>
              </label>
            </fieldset>

            <fieldset class="print-controls__group">
              <legend data-i18n="print.eraser">Eraser</legend>
              <label class="print-controls__check">
                <input type="checkbox" data-role="erase" />
                <span data-i18n="print.eraseToggle"
                  >Erase parts of the border</span
                >
              </label>
              <label class="print-controls__field">
                <span data-i18n="print.brush">Brush</span>
                <input
                  type="range"
                  data-role="erase-size"
                  min="2"
                  max="40"
                  step="1"
                  value="8"
                />
                <output data-role="erase-size-out"></output>
              </label>
              <div class="print-controls__row">
                <button
                  type="button"
                  class="btn btn--ghost btn--icon"
                  data-role="undo"
                  data-i18n-attrs="title=print.undo;aria-label=print.undo"
                >
                  <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                </button>
                <button
                  type="button"
                  class="btn btn--ghost btn--icon"
                  data-role="redo"
                  data-i18n-attrs="title=print.redo;aria-label=print.redo"
                >
                  <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                </button>
                <button
                  type="button"
                  class="btn btn--ghost"
                  data-role="clear-erase"
                  data-i18n="print.restore"
                >
                  Restore all
                </button>
              </div>
            </fieldset>

            <fieldset class="print-controls__group" data-role="card-only">
              <legend data-i18n="print.card">Card</legend>
              <!-- Both fields are suggested rather than filled: the guess goes
                   in the placeholder and every candidate goes in the datalist.
                   autocomplete is off so the browser's own history of past
                   form values does not compete with the list built from the
                   map. Datalist ids are assigned by print.js at open
                   time, since a template can be cloned multiple times and a
                   hardcoded id would collide. -->
              <label class="print-controls__field">
                <span data-i18n="print.locality">Locality</span>
                <input
                  type="text"
                  data-role="locality"
                  autocomplete="off"
                  data-i18n-attrs="title=print.localityHint"
                />
                <datalist data-role="locality-options"></datalist>
              </label>
              <label class="print-controls__field">
                <span data-i18n="print.territoryNo">Territory no.</span>
                <input
                  type="text"
                  data-role="territory"
                  autocomplete="off"
                  data-i18n-attrs="title=print.territoryHint"
                />
                <datalist data-role="territory-options"></datalist>
              </label>
              <label class="print-controls__field">
                <span data-i18n="print.template">PDF template</span>
                <input
                  type="file"
                  data-role="template"
                  accept="application/pdf"
                />
              </label>
              <p
                class="print-controls__hint"
                data-role="template-name"
                data-i18n="print.noTemplate"
              >
                No template — the map prints on its own.
              </p>
              <div class="print-controls__row">
                <button
                  type="button"
                  class="btn btn--ghost"
                  data-role="clear-template"
                  data-i18n="print.clearTemplate"
                  hidden
                >
                  Clear template
                </button>
                <button
                  type="button"
                  class="btn btn--ghost"
                  data-role="adjust-template"
                  data-i18n="print.adjustTemplate"
                  hidden
                >
                  Adjust map area
                </button>
              </div>
            </fieldset>

            <!-- ── The wall map ──────────────────────────────────────────
                 Shown instead of the Card fieldset above. Everything else in
                 this column - the frame, the basemap, the decorations, the
                 notes, the border, the eraser - means the same thing for a
                 poster as it does for a card, which is why there is one
                 dialog rather than two. -->
            <fieldset
              class="print-controls__group"
              data-role="wall-only"
              hidden
            >
              <legend data-i18n="print.wall">Wall map</legend>
              <label class="print-controls__field">
                <span data-i18n="print.pageSize">Sheet</span>
                <select data-role="page-size">
                  <option value="a4">A4</option>
                  <option value="a3" selected>A3</option>
                  <option value="a2">A2</option>
                  <option value="a1">A1</option>
                  <option value="a0">A0</option>
                </select>
              </label>
              <label class="print-controls__check">
                <input type="checkbox" data-role="landscape" />
                <span data-i18n="print.landscape">Landscape</span>
              </label>
              <!-- Suggested from the same tally of OpenStreetMap addresses
                   the cards use for their locality, and offered rather than
                   filled in: see print.js. -->
              <label class="print-controls__field">
                <span data-i18n="print.wallTitleField">Heading</span>
                <input
                  type="text"
                  data-role="title-text"
                  autocomplete="off"
                  data-i18n-attrs="title=print.wallTitleHint"
                />
                <datalist data-role="title-options"></datalist>
              </label>
              <label class="print-controls__check">
                <input type="checkbox" data-role="numbers" checked />
                <span data-i18n="print.wallNumbers">Number the territories</span>
              </label>
              <label class="print-controls__check">
                <input type="checkbox" data-role="outline" checked />
                <span data-i18n="print.wallOutline">Draw the area outline</span>
              </label>
              <p class="print-controls__hint" data-i18n="print.wallHint">
                Every territory of the project on one sheet, at the size chosen
                here. Nothing is marked as printed &mdash; a poster is not a
                stack of cards.
              </p>
            </fieldset>

            <!-- Its own group rather than a line inside the Card fieldset:
                 both a card printed onto a template and a wall map are PDFs
                 of this app's own making, and both can carry the project.
                 Checked by default so the backup happens without being asked
                 for; unticking it is for handing one card to somebody who
                 should not have the whole plan. -->
            <fieldset
              class="print-controls__group"
              data-role="attach-group"
              hidden
            >
              <legend data-i18n="print.backup">Backup</legend>
              <label class="print-controls__check">
                <input type="checkbox" data-role="attach" checked />
                <span data-i18n="print.attach">Embed the project in the PDF</span>
              </label>
              <p class="print-controls__hint" data-i18n="print.attachHint">
                The card can then be imported to restore the boundary and the
                territories.
              </p>
            </fieldset>
          </div>
        </div>

        <!-- Action bar is a flex sibling of the body (not inside the
             scrolling settings column) so the primary buttons are always
             visible and can't be scrolled out of view. -->
        <div class="app-dialog__actions print-dialog__actions">
          <!-- Appears after a card has been generated. Opens the output
               file in a new tab — useful when the browser won't let the
               print frame drive its built-in viewer. -->
          <a
            class="btn btn--ghost print-dialog__open"
            data-role="open-file"
            target="_blank"
            rel="noopener"
            data-i18n="print.openFile"
            hidden
          >
            Open the card
          </a>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="print.cancel"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn btn--ghost print-dialog__save"
            data-role="download"
            data-i18n="print.download"
            data-i18n-attrs="title=print.downloadHint"
          >
            Download
          </button>
          <button
            type="button"
            class="btn btn--primary print-dialog__go"
            data-role="print"
            data-i18n="print.print"
            data-i18n-attrs="title=print.printHint"
          >
            Print
          </button>
        </div>
      </div>
    </template>

    <template id="tpl-place-dialog">
      <div
        class="app-dialog place-dialog"
        role="dialog"
        aria-modal="true"
        aria-label="Position the map"
        tabindex="-1"
      >
        <h2 class="app-dialog__title" data-i18n="place.title">
          Position the map
        </h2>

        <!-- Same three-band layout as the print dialog: fixed title,
             scrollable body, and a fixed action bar that stays visible. -->
        <div class="place-dialog__body">
          <p class="app-dialog__hint" data-i18n="place.hint">
            Drag the frame over the part of the card where the map should print.
          </p>
          <p class="app-dialog__hint" data-i18n="place.keys">
            Arrow keys nudge the map by 1 pt · Hold additionally Shift to move by
            10 pt · Hold additionally Alt to move by 0.1 pt · Hold additionally
            Ctrl to resize · Enter to accept
          </p>

          <!-- The wrapper centers the stage; the stage must match the
               rendered page image exactly because .place-box is positioned
               relative to it. -->
          <div class="place-stage-wrap">
            <div class="place-stage" data-role="stage">
              <img class="place-page" data-role="page" alt="" />
              <div class="place-box" data-role="box">
                <span class="place-handle" data-h="nw"></span>
                <span class="place-handle" data-h="ne"></span>
                <span class="place-handle" data-h="se"></span>
                <span class="place-handle" data-h="sw"></span>
              </div>

              <div class="place-loupe" data-role="loupe" hidden>
                <div class="place-loupe__inner" data-role="loupe-inner">
                  <div class="place-loupe__box" data-role="loupe-box"></div>
                </div>
                <div class="place-loupe__cross" aria-hidden="true"></div>
              </div>
            </div>
          </div>

          <output class="place-readout" data-role="readout"></output>
          <p
            class="place-notice"
            data-role="notice"
            role="status"
            aria-live="polite"
            hidden
          ></p>
        </div>

        <div class="app-dialog__actions place-dialog__actions">
          <button
            type="button"
            class="btn btn--ghost"
            data-role="snap"
            data-i18n="place.snap"
          >
            Snap to detected box
          </button>
          <button
            type="button"
            class="btn btn--ghost"
            data-role="cancel"
            data-i18n="place.cancel"
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn btn--primary place-dialog__go"
            data-role="save"
            data-i18n="place.save"
          >
            Use this area
          </button>
        </div>
      </div>
    </template>

    <!-- ── Guided tour ──────────────────────────────────────────────────
         A single template for the entire tour. The veil blocks clicks on
         the page behind it. The spot is a transparent box with a large
         box-shadow that creates the dimming effect — the highlighted
         control stays at full brightness because the shadow spreads outward
         from the spot, not inward. The bubble holds the step text.

         Mounted on <body> (not the map container) because some targets —
         the search field, the layer switcher — are Leaflet controls that
         render above anything inside the map container. -->
    <template id="tpl-tour">
      <div class="tour" role="dialog" aria-modal="true" aria-labelledby="tour-title">
        <div class="tour__veil" data-role="veil"></div>
        <div class="tour__spot" data-role="spot" hidden></div>
        <!-- Second highlight ring for the button that opened the control
             being pointed at. Placed after the spot so it paints over the
             dimming (which is the spot's own box-shadow). -->
        <div class="tour__spot tour__origin" data-role="origin" hidden></div>

        <div class="tour__bubble" data-role="bubble" tabindex="-1">
          <div class="tour__head">
            <span class="tour__count" data-role="counter"></span>
            <button
              type="button"
              class="tour__close"
              data-role="skip"
              data-i18n-attrs="title=tour.skip;aria-label=tour.skip"
            >
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </div>

          <h2 class="tour__title" id="tour-title" data-role="title"></h2>
          <p class="tour__body" data-role="body"></p>

          <div class="tour__actions">
            <button
              type="button"
              class="btn btn--ghost tour__back"
              data-role="back"
              data-i18n="tour.back"
            >
              Back
            </button>
            <button
              type="button"
              class="btn btn--primary tour__next"
              data-role="next"
              data-i18n="tour.next"
            >
              Next
            </button>
          </div>

          <label class="tour__mute">
            <input type="checkbox" data-role="mute" checked />
            <span data-i18n="tour.dontShow">Don't show this automatically</span>
          </label>
        </div>
      </div>
    </template>

    <!-- Vendor -->
    <script src="{{ url_for('static', filename='vendor/cdn.jsdelivr.net/npm/leaflet-editable/src/Leaflet.Editable.min.js') }}"></script>
    <link
      rel="stylesheet"
      href="{{ url_for('static', filename='vendor/cdn.jsdelivr.net/npm/leaflet-control-geocoder/dist/Control.Geocoder.css') }}"
    />
    <script src="{{ url_for('static', filename='vendor/cdn.jsdelivr.net/npm/leaflet-control-geocoder/dist/Control.Geocoder.min.js') }}"></script>

    <!-- App modules — load order matters (state first, main last) -->
    <script src="{{ url_for('static', filename='js/util.js') }}"></script>
    <script src="{{ url_for('static', filename='js/i18n.js') }}"></script>
    <script src="{{ url_for('static', filename='js/state.js') }}"></script>
    <script src="{{ url_for('static', filename='js/store.js') }}"></script>
    <script src="{{ url_for('static', filename='js/dom.js') }}"></script>
    <script src="{{ url_for('static', filename='js/shortcuts.js') }}"></script>
    <!-- Must load before trim.js and outline.js: both build their keyboard
         context at load time and request the eraser shortcut from this
         module. -->
    <script src="{{ url_for('static', filename='js/vertices.js') }}"></script>
    <script src="{{ url_for('static', filename='js/basemap.js') }}"></script>
    <script src="{{ url_for('static', filename='js/geometry.js') }}"></script>
    <script src="{{ url_for('static', filename='js/spatial.js') }}"></script>
    <script src="{{ url_for('static', filename='js/coverage.js') }}"></script>
    <script src="{{ url_for('static', filename='js/network.js') }}"></script>
    <script src="{{ url_for('static', filename='js/ui.js') }}"></script>
    <script src="{{ url_for('static', filename='js/polygons.js') }}"></script>
    <script src="{{ url_for('static', filename='js/labels.js') }}"></script>
    <script src="{{ url_for('static', filename='js/naming.js') }}"></script>
    <!-- Must load before its callers: data.js uses it when importing a card
         and print.js uses it when composing one. Neither resolves it at load
         time, but a shared dependency belongs ahead of its consumers. -->
    <script src="{{ url_for('static', filename='js/pdfdoc.js') }}"></script>
    <script src="{{ url_for('static', filename='js/data.js') }}"></script>
    <script src="{{ url_for('static', filename='js/session.js') }}"></script>
    <script src="{{ url_for('static', filename='js/clustering.js') }}"></script>
    <script src="{{ url_for('static', filename='js/editing.js') }}"></script>
    <script src="{{ url_for('static', filename='js/trim.js') }}"></script>
    <script src="{{ url_for('static', filename='js/outline.js') }}"></script>
    <script src="{{ url_for('static', filename='js/gaps.js') }}"></script>
    <script src="{{ url_for('static', filename='js/footprints.js') }}"></script>
    <script src="{{ url_for('static', filename='js/autoheal.js') }}"></script>
    <!-- Before print.js, which asks it for what to draw on a card. -->
    <script src="{{ url_for('static', filename='js/notes.js') }}"></script>
    <script src="{{ url_for('static', filename='js/print-filters.js') }}"></script>
    <script src="{{ url_for('static', filename='js/print.js') }}"></script>
    <script src="{{ url_for('static', filename='js/boundary.js') }}"></script>
    <script src="{{ url_for('static', filename='js/history.js') }}"></script>
    <script src="{{ url_for('static', filename='js/controls.js') }}"></script>
    <script src="{{ url_for('static', filename='js/demo.js') }}"></script>
    <script src="{{ url_for('static', filename='js/tour.js') }}"></script>
    <script src="{{ url_for('static', filename='js/pwa.js') }}"></script>
    <script src="{{ url_for('static', filename='js/main.js') }}"></script>
  </body>
</html>
